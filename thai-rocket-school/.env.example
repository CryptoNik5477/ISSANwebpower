# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, RDS, or the bundled docker-compose db)
DATABASE_URL="postgresql://thairocketschool:thairocketschool@localhost:5432/thairocketschool?schema=public"

# ─── Application ─────────────────────────────────────────────────────────────
# Public URL of the deployed site (used for emails, Stripe redirects, SEO)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Auth (NextAuth) ─────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Optional Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook signing secret (stripe listen --forward-to localhost:3000/api/stripe/webhook)
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Email (Resend HTTP API — leave empty to log emails to the console) ──────
RESEND_API_KEY=""
EMAIL_FROM="Thai Rocket School <hello@thairocketschool.com>"

# ─── AI features (Claude API — leave empty to use the built-in heuristic mode)
ANTHROPIC_API_KEY=""

# ─── Media storage ───────────────────────────────────────────────────────────
# Vercel Blob (or any S3-compatible bucket) for lesson videos / audio uploads
BLOB_READ_WRITE_TOKEN=""

# ─── Cron / automation ───────────────────────────────────────────────────────
# Shared secret protecting /api/cron/* endpoints (daily reminder emails, etc.)
CRON_SECRET="change-me"

# ─── One-time DB seed (optional) ─────────────────────────────────────────────
# Set this, redeploy, then visit https://<your-app>/api/admin/seed?secret=...
# once to populate courses/lessons/exams without needing local DB access.
# Remove the variable afterwards.
SEED_SECRET=""
