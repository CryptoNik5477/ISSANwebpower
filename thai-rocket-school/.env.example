# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, RDS, or the bundled docker-compose db)
DATABASE_URL="postgresql://thairocketschool:thairocketschool@localhost:5432/thairocketschool?schema=public"

# ─── Application ─────────────────────────────────────────────────────────────
# Public URL of the deployed site (used for emails, Stripe redirects, SEO)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Auth (NextAuth) ─────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Optional Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook signing secret (stripe listen --forward-to localhost:3000/api/stripe/webhook)
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Email (Resend HTTP API — leave empty to log emails to the console) ──────
RESEND_API_KEY=""
EMAIL_FROM="Thai Rocket School <hello@thairocketschool.com>"

# ─── AI features (Claude API — leave empty to use the built-in heuristic mode)
ANTHROPIC_API_KEY=""

# ─── Media storage ───────────────────────────────────────────────────────────
# Vercel Blob — required for generated pronunciation audio (see TTS below),
# and usable for lesson videos/PDFs too. Vercel → Storage → Create → Blob.
BLOB_READ_WRITE_TOKEN=""

# ─── Text-to-speech (native Thai pronunciation audio) ────────────────────────
# elevenlabs.io → sign up (free, no credit card) → Profile → API keys.
# Leave empty to keep using the browser's built-in (lower quality) speech
# synthesis as a fallback. ELEVENLABS_VOICE_ID is optional (defaults to the
# standard pre-made "Rachel" voice, which speaks Thai via the multilingual model).
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""

# ─── Cron / automation ───────────────────────────────────────────────────────
# Shared secret protecting /api/cron/* endpoints (daily reminder emails, etc.)
CRON_SECRET="change-me"

# ─── One-time admin actions (optional) ───────────────────────────────────────
# Set this, redeploy, then visit (from any browser, no terminal needed):
#   https://<your-app>/api/admin/seed?secret=...            — populate courses/lessons/exams
#   https://<your-app>/api/admin/generate-audio?secret=...  — generate pronunciation audio
# Both are safe to re-run (they skip what's already done). Remove this
# variable once you're done to close off the endpoints.
ADMIN_SECRET=""
